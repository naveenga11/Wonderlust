 <% if(success && success.length ){ %> 
  <div class="alert alert-success alert-dismissible fade show col-6 offset-2" role="alert">
  <%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>


 <% if(error && error.length ){ %> 
  <div class="alert alert-success alert-dismissible fade show col-6 offset-2" role="alert">
  <%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<% } %>

<!-- success is an arr ,it exitings even no elements -->
