<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3><%= listing.title %></h3>
      <div class="card listing-card" style="width: 18rem;">
        <img src="<%= listing.image.url %> " class="card-img-top" alt="listing_image">
        <div class="card-body">
          <p class="card-text">Owned by : <i><%= listing.owner.username %></i></p>
          <p class="card-text"><%= listing.description %></p>
          <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %>/night</p>
          <p class="card-text"><%= listing.location %></p>
          <p class="card-text"><%= listing.country %></p>         
        </div>
      </div>
       <% if(curUser && curUser._id.equals(listing.owner._id)){ %> 
      <div class="btns">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit</a>
          <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-primary mt-2">Delete</button>
          </form>
      </div>
      <% } %>

      
      
      <!-- review -->
      <div> <!--class="col-8 offset-2" -->
        <hr>
        <h4>Leave a review</h4>

        <form action="/listings/<%= listing.id %>/reviews" method="post" class="mt-3 mb-3 needs-validation" novalidate >


          <!-- 
            <input type="range" name="review[rating]" min="1" max="5" class="form-range">
          </div> -->


          <div class="mt-3 mb-3">
            <label class="form-label">Rating</label>
            <div class="star-rating-widget">
              <div class="stars-row" id="starsRow">
                <span class="star" data-value="1">&#9733;</span>
                <span class="star" data-value="2">&#9733;</span>
                <span class="star" data-value="3">&#9733;</span>
                <span class="star" data-value="4">&#9733;</span>
                <span class="star" data-value="5">&#9733;</span>
              </div>
              <span class="rating-label" id="ratingLabel">Select a rating</span>
              <!-- hidden input carries the value to the server -->
              <input type="hidden" name="review[rating]" id="ratingInput" value="" required />
            </div>
          </div>

          <style>
            .star-rating-widget { display: flex; align-items: center; gap: 0.75rem; }
            .stars-row { display: flex; gap: 4px; }
            .star {
              font-size: 2rem;
              color: #d1d5db;
              cursor: pointer;
              transition: color 0.15s, transform 0.15s;
              line-height: 1;
              user-select: none;
            }
            .star.hovered, .star.selected { color: #f59e0b; }
            .star:hover { transform: scale(1.2); }
            .rating-label {
              font-size: 0.85rem;
              color: #6b7280;
              font-style: italic;
              min-width: 90px;
            }
          </style>

          <script>
            (function () {
              const labels = ["Terrible","Not good","Average","Very good","Amazing"];
              const stars  = document.querySelectorAll("#starsRow .star");
              const input  = document.getElementById("ratingInput");
              const lbl    = document.getElementById("ratingLabel");
              let selected = 0;

              function paint(upTo, cls) {
                stars.forEach(function(s, i) {
                  s.classList.toggle(cls, i < upTo);
                });
              }

              stars.forEach(function(star) {
                star.addEventListener("mouseenter", function() {
                  const v = +star.dataset.value;
                  paint(v, "hovered");
                  lbl.textContent = labels[v - 1];
                });
                star.addEventListener("mouseleave", function() {
                  paint(0, "hovered");
                  lbl.textContent = selected ? labels[selected - 1] : "Select a rating";
                });
                star.addEventListener("click", function() {
                  selected = +star.dataset.value;
                  input.value = selected;
                  paint(selected, "selected");
                  lbl.textContent = labels[selected - 1];
                });
              });
            })();
          </script>

          <div class="mt-3 mb-3">
            <label for="comment" class="form-label">Comments</label>
            <textarea name="review[comment]" required id="comment" cols="20" rows="5" class="form-control"></textarea>
            <div class="invalid-feedback">please add some Comments</div>
          </div>
          <button class="btn btn-dark mt-3">submit</button>
        </form>
      </div>

      <hr>
      <p><b>All Reviews</b></p>
      <div class="row">
        <% for (review of listing.reviews) { %>
        <div class="card col-5 ms-3 mb-3"> 
          <div class="card-body">
            <h5 class="card-title">@<%= review.author.username %></h5>
            <p class="card-text"><%=review.comment %></p>
             <p class="starability-result card-text" data-rating="<%=review.rating %>"> </p>
          </div>
          <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" class="mb-3 mt-3">
            <button class="btn btn-sm btn-danger">delete</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</body>
