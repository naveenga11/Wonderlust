<% layout("/layouts/boilerplate") %>
  <body>
    

    <div class="row mt-3">
      <div class="col-8 offset-2">
        <h3><%= listing.title %></h3>
          <div class="card" style="width: 18rem;">
    <img src="<%= listing.image.url %> " class="card-img-top" alt="listing_image">
    <div class="card-body">
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
      <p class="card-text"><%= listing.location %></p>
      <p class="card-text"><%= listing.country %></p>

      <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit</a>
    </div>
  </div>
  <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-primary">Delete</button>
    </form>

      <!-- review -->
    <div> <!--class="col-8 offset-2" -->
      <hr>
      <h4>Leave a review</h4>
    
      <form action="/listings/<%= listing.id %>/reviews" method="post" class="mt-3 mb-3 needs-validation" novalidate >
        <div class="mt-3 mb-3">
          <label for="rating" class="form-label"></label>Rating</label>
          <input type="range" name="review[rating]" id="" min="1" max="5" class="form-range">
        </div>
        <div class="mt-3 mb-3">
          <label for="comment" class="form-label"></label>Comments</label>
          <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control" required></textarea>
          <div class="invalid-feedback">please add some Comments</div>
        </div>
        <button class="btn btn-dark mt-3">submit</button>
      </form>
    </div>

    <hr>
    <h4>All reviews</h4>
    <% for (reviews of listing.reviews) { %>
    \<li> <%=review.comment %> ,  <%=review.rating %></li>
      <% } %>
      </div>
    </div>
  </body>
