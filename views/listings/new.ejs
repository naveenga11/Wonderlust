<% layout("/layouts/boilerplate") %>
  <body>
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" class="needs-validation" novalidate>
      <input name="listing[title]" placeholder="enter title" type="text" required />
      <br /><br />
      <textarea
        name="listing[description]"
        placeholder="enter description"
       required 
      ></textarea>
      <br /><br />
      <input
        name="listing[image]"
        placeholder="enter image URL/Link"
        type="text"
      />
      <br /><br />
      <input name="listing[price]" placeholder="enter price" type="number" required/>
      <br /><br />
      <input name="listing[country]" placeholder="enter country" type="text" required/>
      <br /><br />
      <input
        name="listing[location]"
        placeholder="enter location"
        type="text"
        required
      />
      <br /><br />
      <button>Add</button>
    </form>
    <script src="/public/js/script.js"></script>
  </body>
