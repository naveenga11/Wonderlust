<% layout("/layouts/boilerplate") %>


<div class="row mt-3">
  <div class="col-8 offset-2">
    <h1 class="mb-4">Create a New Listing</h1>
    <form action="/listings" method="POST" novalidate class="needs-validation" >
      
      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="Add a catchy title"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">Nice name!</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="3"
          required
        ></textarea>
        <div class="invalid-feedback">Description needed!</div>
      </div>

      <!-- Image Link -->
      <div class="mb-3">
        <label for="image" class="form-label">Image Link</label>
        <input
          name="listing[image][url]"
          placeholder="Enter image URL/Link"
          type="text"
          class="form-control"
        />
      </div>

      <!-- Price -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="1200"
            type="text"
            class="form-control"
            required
          />
            <div class="invalid-feedback">price needed!</div>
        </div>
      </div>

      <!-- Country -->
      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input
          name="listing[country]"
          placeholder="India"
          type="text"
          class="form-control"
          required
        />
      </div>

      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="Jaipur, Rajasthan"
          type="text"
          class="form-control"
          required
        />
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn btn-dark add-btn mt-3">Add</button>
    </form>
  </div>
</div>


